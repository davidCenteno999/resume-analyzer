# Select anthropic, github_models, openai, or gemini. If omitted, github_models is used.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_OUTPUT_TOKENS=2048

# Keys for alternative providers (only the selected provider requires its key).
GITHUB_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=resume_analyzer
JWT_SECRET_KEY=replace-with-a-long-random-secret
